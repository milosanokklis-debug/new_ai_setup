      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "hallmark": {
      "source": {
        "source": "github",
        "repo": "Nutlope/hallmark"
      }
    },
    "design-plugins": {
      "source": {
        "source": "github",
        "repo": "0xdesign/design-plugin"
      }
    },
    "agent-kit": {
      "source": {
        "source": "github",
