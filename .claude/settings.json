    "design-and-refine@design-plugins": true,
    "kit-design@agent-kit": true,
    "kit-code@agent-kit": true,
    "basic-memory@basicmachines-co": true,
    "taste-skill@agent-kit": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
