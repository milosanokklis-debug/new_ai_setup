{
  "name": "agent-kit",
  "owner": {
    "name": "Computer Agent"
  },
  "description": "Personal Claude Code kit: core + design + code packs",
  "metadata": {
    "description": "Personal Claude Code kit: core + design + code packs",
    "version": "0.4.0"
  },
  "allowCrossMarketplaceDependenciesOn": [
    "addy-agent-skills",
    "superpowers-marketplace",
    "hallmark",
    "design-plugins"
  ],
  "plugins": [
    {
      "name": "kit-core",
      "source": "./plugins/kit-core",
      "version": "0.4.0",
      "description": "Base pack: methodology, orchestrator guard, Playwright, Chrome DevTools, Context7.",
      "dependencies": [
        "agent-skills@addy-agent-skills"
      ]
    },
    {
      "name": "kit-design",
      "source": "./plugins/kit-design",
      "version": "0.4.0",
      "description": "UI pack: designer, design-auditor, design skills, shadcn and Motion MCP.",
      "dependencies": [
        "kit-core",
        "hallmark@hallmark",
        "design-and-refine@design-plugins",
        "taste-skill"
      ]
    },
    {
      "name": "kit-code",
      "source": "./plugins/kit-code",
      "version": "0.4.0",
      "description": "Code pack: coder, reviewers, ponytail-review, Semgrep MCP.",
      "dependencies": [
        "kit-core"
      ]
    },
    {
      "name": "taste-skill",
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill",
        "sha": "12af471f627f866411b4bd785b19646d3672784c"
      },
      "description": "tasteskill v2: art direction for websites, product pages, dashboards and app screens, with a library of researched directions, real pictures from open collections and a real-browser inspector.",
      "version": "2.1.5",
      "skills": [
        "./skills/taste-skill"
      ],
      "author": {
        "name": "leonxlnx",
        "email": "hello@tasteskill.dev"
      },
      "homepage": "https://github.com/Leonxlnx/taste-skill",
      "repository": "https://github.com/Leonxlnx/taste-skill",
      "license": "MIT",
      "keywords": [
        "skills",
        "frontend",
        "design",
        "taste",
        "ui",
        "dashboard"
      ]
    },
    {
      "name": "gsap-skills",
      "source": {
        "source": "github",
        "repo": "greensock/gsap-skills",
        "sha": "aed9cfd3277740755f6bfc1155c7aa645403b760"
      },
      "description": "Official GSAP skills for Cursor, Claude and other AI agents, covering tweens, timelines, ScrollTrigger, plugins, utilities, React hooks, and performance optimization",
      "author": {
        "name": "GreenSock"
      },
      "category": "productivity"
    },
    {
      "name": "typescript-lsp",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "plugins/typescript-lsp",
        "sha": "a7ba5b93db0c7c8d17f3f1d25853adca79598a1a"
      },
      "description": "TypeScript/JavaScript language server for enhanced code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "Anthropic",
        "email": "support@anthropic.com"
      },
      "category": "development",
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": [
            "--stdio"
          ],
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mts": "typescript",
            ".cts": "typescript",
            ".mjs": "javascript",
            ".cjs": "javascript"
          }
        }
      }
    },
    {
      "name": "pyright-lsp",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "plugins/pyright-lsp",
        "sha": "a7ba5b93db0c7c8d17f3f1d25853adca79598a1a"
      },
      "description": "Python language server (Pyright) for type checking and code intelligence",
      "version": "1.0.0",
      "author": {
        "name": "Anthropic",
        "email": "support@anthropic.com"
      },
      "category": "development",
      "strict": false,
      "lspServers": {
        "pyright": {
          "command": "pyright-langserver",
          "args": [
            "--stdio"
          ],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    }
  ]
}
